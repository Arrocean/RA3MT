<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>RA3 trainer core: attach, pattern scan, detour engine, feature definitions</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\features.json" Link="Data\features.json" />
    <EmbeddedResource Include="..\..\assets\reinforcement_codes.json" Link="Data\reinforcement_codes.json" />
  </ItemGroup>

  <!-- keep .pdb files out of single-file publish output -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
