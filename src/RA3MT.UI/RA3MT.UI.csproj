<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x86</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RA3MT.UI</RootNamespace>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <!-- WPF native dependencies (wpfgfx, PresentationNative, D3DCompiler,
         vcruntime...) ride inside the single-file exe and self-extract at
         startup, so the publish output is one exe and nothing else. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- Single-file publish uses the official distribution name; dev/debug
       builds keep the plain RA3MT.UI name. Keep this version in sync with
       MainVM.AppVersion (both bump every release). -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
    <AssemblyName>Red Alert 3 Modern Trainer v261013-7</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RA3MT.Core\RA3MT.Core.csproj" />
  </ItemGroup>

</Project>
