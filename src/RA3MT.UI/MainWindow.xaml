<Window x:Class="RA3MT.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RA3 Trainer · 现代重制版" Width="1240" Height="840"
        MinWidth="1080" MinHeight="700" Icon="app.ico"
        Background="#0d1117" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- feature card -->
    <DataTemplate x:Key="FeatureCard">
      <Border x:Name="card" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
              BorderThickness="1" CornerRadius="11" Padding="15,13" Margin="0,0,0,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="34" Height="34" CornerRadius="9" Background="#1c2537"
                  BorderBrush="{StaticResource Line}" BorderThickness="1">
            <TextBlock Text="{Binding Icon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
              <Border Background="#10151f" BorderBrush="#2a3550" BorderThickness="1" CornerRadius="6"
                      Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding HasHotkey, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Hotkey}" FontFamily="Cascadia Code,Consolas" FontSize="10.5"
                           Foreground="#aeb9d0" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Desc}" FontSize="11" Foreground="{StaticResource Txt2}"
                       Margin="0,3,0,0" TextWrapping="Wrap" MaxHeight="30" />
          </StackPanel>
          <Grid Grid.Column="2" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
            <TextBox Width="112" VerticalContentAlignment="Center"
                     FontFamily="Cascadia Code,Consolas" FontSize="11.5"
                     Background="#10151f" BorderBrush="#2a3550" BorderThickness="1" Foreground="#dfe6f5"
                     Padding="6,4" MaxLength="32" VerticalAlignment="Center"
                     ToolTip="{Binding ArgPlaceholder}"
                     Text="{Binding CodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding NeedsCode, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="📋" FontSize="12" Width="28" Height="28" Margin="4,0,0,0"
                    Background="#10151f" BorderBrush="#2a3550" BorderThickness="1"
                    Foreground="#dfe6f5" Cursor="Hand" Click="OnPickSuggestion"
                    ToolTip="从内置单位表选择增援代码（也可手动输入十六进制代码）"
                    Visibility="{Binding HasPicker, Converter={StaticResource BoolToVisibility}}" />
          </StackPanel>
            <Grid Grid.Column="1">
              <ToggleButton Style="{StaticResource Switch}"
                            IsChecked="{Binding IsOn, Mode=TwoWay}"
                            IsEnabled="{Binding IsEnabled}"
                            Visibility="{Binding IsToggle, Converter={StaticResource BoolToVisibility}}" />
              <Button Style="{StaticResource BtnExec}" Content="执行"
                      Command="{Binding Execute}"
                      Visibility="{Binding IsAction, Converter={StaticResource BoolToVisibility}}" />
              <Border Background="#1a2233" BorderBrush="{StaticResource Line}" BorderThickness="1"
                      CornerRadius="8" Padding="10,6"
                      Visibility="{Binding IsPending, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="待逆向" FontSize="10" Foreground="{StaticResource Txt3}" />
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsOn}" Value="True">
          <Setter TargetName="card" Property="BorderBrush" Value="#6d7cff" />
          <Setter TargetName="card" Property="Background" Value="#171d2e" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="GroupTemplate">
      <StackPanel Margin="0,0,0,14">
        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
          <Border Width="4" Height="15" CornerRadius="3" Background="{StaticResource Grad}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" Margin="9,0,0,0" />
          <TextBlock FontSize="11" Foreground="{StaticResource Txt2}" Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Text="{Binding Items.Count, StringFormat={}{0} 项}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource FeatureCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="38" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ============ title bar ============ -->
    <Border Background="#0a0e15" BorderBrush="#151d2b" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
          <TextBlock Text="RA3 Trainer" FontWeight="SemiBold" FontSize="12.5" />
          <TextBlock Text="  ·  Command &amp; Conquer: Red Alert 3" FontSize="12.5" Foreground="{StaticResource Txt2}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Width="42" Height="30" Content="─" Background="Transparent" Foreground="{StaticResource Txt2}"
                  BorderThickness="0" Click="OnMinimize" Cursor="Hand" />
          <Button Width="42" Height="30" Content="✕" Background="Transparent" Foreground="#e05555"
                  BorderThickness="0" Click="OnClose" Cursor="Hand" FontSize="13" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ============ body ============ -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="248" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- sidebar -->
      <Border Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,18,14,14">
          <!-- game card -->
          <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="12" Padding="12">
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="9">
                <Border.Background>
                  <RadialGradientBrush Center="0.3,0.25" RadiusX="0.9" RadiusY="0.9">
                    <GradientStop Color="#ff5f57" Offset="0" />
                    <GradientStop Color="#b3231b" Offset="0.45" />
                    <GradientStop Color="#5c0f0c" Offset="1" />
                  </RadialGradientBrush>
                </Border.Background>
                <TextBlock Text="RA3" FontWeight="ExtraBold" FontSize="13" Foreground="#ffe9c9"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="红色警戒 3" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Text="命令与征服" FontSize="12.5" FontWeight="SemiBold" Opacity="0.9" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Ellipse Width="6" Height="6" Fill="{StaticResource Ok}" VerticalAlignment="Center" />
                  <TextBlock Text="1.13 已支持 · 兼容 1.12" FontSize="10.5" Foreground="{StaticResource Ok}" Margin="5,0,0,0" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- logo -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,16">
            <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Grad}">
              <TextBlock Text="RA3" FontWeight="ExtraBold" FontSize="14" Foreground="White"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="RA3 Trainer" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="v35 · 现代重制版" FontSize="11" Foreground="{StaticResource Txt2}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <!-- nav -->
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="菜单" FontSize="10.5" Foreground="{StaticResource Txt3}" Margin="8,0,0,8" />
            <Border Background="#191f30" BorderBrush="#6d7cff" BorderThickness="1" CornerRadius="9" Padding="10,9" Margin="0,0,0,3">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚡" Width="17" TextAlignment="Center" />
                <TextBlock Text="作弊功能" FontSize="13" Foreground="#c3caff" Margin="10,0,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- main -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,10">
          <StackPanel>
            <!-- hero -->
            <Border CornerRadius="14" Padding="22,20" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Margin="0,0,0,14">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="1">
                  <GradientStop Color="#151c28" Offset="0" />
                  <GradientStop Color="#181f31" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="64" CornerRadius="13">
                  <Border.Background>
                    <RadialGradientBrush Center="0.3,0.25" RadiusX="0.9" RadiusY="0.9">
                      <GradientStop Color="#ff5f57" Offset="0" />
                      <GradientStop Color="#b3231b" Offset="0.45" />
                      <GradientStop Color="#5c0f0c" Offset="1" />
                    </RadialGradientBrush>
                  </Border.Background>
                  <TextBlock Text="RA3" FontWeight="ExtraBold" FontSize="17" Foreground="#ffe9c9"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="命令与征服：红色警戒 3" FontSize="19" FontWeight="Bold" />
                  <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <Border Margin="0,0,8,0" CornerRadius="10" Padding="9,3" Background="#123329"
                            BorderBrush="#1d5c48" BorderThickness="1">
                      <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Ok}"
                                 Text="{Binding AttachChipText}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                      <TextBlock FontSize="10.5" Foreground="{StaticResource Txt2}"
                                 Text="{Binding SiteCheckText}" />
                    </Border>
                    <Border Style="{StaticResource Chip}">
                      <TextBlock FontSize="10.5" Foreground="{StaticResource Txt2}" Text="兼容 1.12 · 终极合集" />
                    </Border>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Style="{StaticResource BtnPrimary}" MinWidth="104" Command="{Binding StartCmd}">
                    <TextBlock Text="{Binding StartButtonText}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>

            <!-- stats -->
            <UniformGrid Columns="4" Margin="0,0,0,16">
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="功能总数" FontSize="11" Foreground="{StaticResource Txt2}" />
                  <TextBlock Text="{Binding TotalFeatures}" FontSize="19" FontWeight="Bold" Margin="0,5,0,0" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="已启用" FontSize="11" Foreground="{StaticResource Txt2}" />
                  <TextBlock FontSize="19" FontWeight="Bold" Margin="0,5,0,0">
                    <Run Text="{Binding EnabledCount, Mode=OneWay}" /><Run Text=" / " Foreground="{StaticResource Txt2}" FontSize="12" /><Run Text="{Binding TotalFeatures, Mode=OneWay}" Foreground="{StaticResource Txt2}" FontSize="12" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="进程状态" FontSize="11" Foreground="{StaticResource Txt2}" />
                  <TextBlock FontSize="19" FontWeight="Bold" Margin="0,5,0,0">
                    <Run Text="{Binding ProcessStateText, Mode=OneWay}" Foreground="{StaticResource Ok}" />
                  </TextBlock>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource StatCard}">
                <StackPanel>
                  <TextBlock Text="游戏 PID" FontSize="11" Foreground="{StaticResource Txt2}" />
                  <TextBlock FontSize="19" FontWeight="Bold" Margin="0,5,0,0"
                             Text="{Binding PidText}" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- feature groups -->
            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" />

            <TextBlock Text="仅限单机使用 · 联网对战不可用 · 感谢原版作者 Ken22265 (2009) 的逆向成果"
                       FontSize="10.5" Foreground="{StaticResource Txt3}" Margin="2,4,0,10" />
          </StackPanel>
        </ScrollViewer>

        <!-- status bar -->
        <Border Grid.Row="1" Background="#0a0e15" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Padding="18,0,18,0" Height="34">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#5b6680" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Attached}" Value="True">
                        <Setter Property="Fill" Value="{StaticResource Ok}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock FontSize="11" Foreground="{StaticResource Txt2}" Margin="8,0,0,0">
                <Run Text="ra3_" /><Run Text="{Binding Version, Mode=OneWay}" /><Run Text=".game" />
              </TextBlock>
              <Border Width="1" Height="14" Background="{StaticResource Line}" Margin="14,0" />
              <TextBlock Text="自动适配 1.12 / 1.13 游戏版本" FontSize="11" Foreground="{StaticResource Txt2}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Border Background="#1c1913" BorderBrush="#4a3d1c" BorderThickness="1" CornerRadius="9" Padding="8,2">
                <TextBlock Text="仅限单机 · 联网对战不可用" FontSize="10" Foreground="{StaticResource Warn}" />
              </Border>
              <TextBlock Text="热键全局生效" FontSize="11" Foreground="{StaticResource Txt2}" Margin="16,0,0,0"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
